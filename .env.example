# --- Walcert Agent ---

# Identity (ERC-8004 on Celo)
AGENT_ID=9699
AGENT_WALLET=0xF4D938200445B0Df0f028af6d90D016147AEd095
PUBLIC_BASE_URL=http://127.0.0.1:8000
CELO_CHAIN_ID=42220

# Data providers (never commit real values)
ALCHEMY_API_KEY=
# Networks for origins/activity (comma-separated Alchemy slugs)
ALCHEMY_NETWORKS=celo-mainnet,bnb-mainnet
# Optional legacy single-network override:
# ALCHEMY_NETWORK=celo-mainnet
# Optional full URL override (disables multi-network list):
# ALCHEMY_HTTP_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_KEY

ZERION_API_KEY=

# GoldRush / Covalent — public Multichain (`POST /v1/certificates/multichain`)
# Also used by the Summit alias `/v1/summit/certificates/multichain-v2`.
# Never commit a real key.
GOLDRUSH_API_KEY=
# GOLDRUSH_INTENSITY_TOP_N=6
# Circuit-breaker (analyses/day). Not a billing cap; flex credits cover overage.
# GOLDRUSH_DAILY_LIMIT=500

# Supabase Edge scoring (A–F certificates)
SUPABASE_FUNCTIONS_URL=https://mezqyworblseixaypftg.supabase.co/functions/v1
# Same value must be set as Edge secret EDGE_SHARED_SECRET in Supabase
EDGE_SHARED_SECRET=
EDGE_SCORING_ENABLED=true

# --- x402 paywall (Track 2: protocolo estandar via facilitador Celo) ---
# Protege POST /v1/certificates/*. El dashboard usa /v1/preview/* (gratis).
X402_ENABLED=false
# CAIP-2. El facilitador oficial (api.x402.celo.org) hoy solo soporta Celo mainnet.
X402_NETWORK=eip155:42220
X402_FACILITATOR_URL=https://api.x402.celo.org
# API key de x402.celo.org (creditos prepagos para /settle). Opcional para /verify.
X402_FACILITATOR_API_KEY=
X402_FACILITATOR_AUTH_HEADER=X-API-Key
# Wallet que recibe los pagos (payTo). Operativa del agente.
X402_PAY_TO=0xF4D938200445B0Df0f028af6d90D016147AEd095
# Precio por certificado (formato dolar; auto-mapea a USDC 6 dec = 50000 atomic).
X402_PRICE=$0.05

# --- x402 Base (facilitador CDP; mismo payTo EOA, USDC nativo de Base) ---
# El 402 lista Celo y Base. Track 2 Celo no se toca.
X402_BASE_ENABLED=true
X402_BASE_NETWORK=eip155:8453
X402_BASE_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# X402_BASE_PAY_TO=  # default = X402_PAY_TO
# Secret API key Live de portal.cdp.coinbase.com (nunca commitear valores).
COINBASE_API_KEY_BASE=
COINBASE_SECRET_BASE=

# --- x402 BNB (Dexter Permit2; USDC 18 dec). Tercer riel; NUNCA accepts[0]. ---
X402_BNB_ENABLED=false
X402_BNB_NETWORK=eip155:56
X402_BNB_FACILITATOR_URL=https://x402.dexter.cash
# X402_BNB_PAY_TO=  # default = X402_PAY_TO
# X402_BNB_USDC=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
BNB_CHAIN_ID=56
BNB_RECEIPT_ENABLED=true
# Contrato soulbound post-deploy Remix (contracts/WalcertBnbReceipt.sol)
BNB_RECEIPT_CONTRACT=

# --- Registro de compras x402 ---
# El agente envia cada pago liquidado a la Edge walcert-payment-log
# (reusa SUPABASE_FUNCTIONS_URL + EDGE_SHARED_SECRET; la service key vive solo
# en la Edge). Poner en false para desactivar el logueo de pagos.
PAYMENT_LOG_ENABLED=true
# PAYMENT_LOG_SLUG=walcert-payment-log

# --- Verificabilidad on-chain (firma EIP-712 + ERC-8004 Reputation Registry) ---
# Firma EIP-712 del data_hash + anclaje por certificado via giveFeedback en el
# Reputation Registry de Celo (0x8004BAa17C55a88189AE136b182e5fdA19dE9b63).
CELO_RPC_URL=https://forno.celo.org
REPUTATION_REGISTRY_ADDRESS=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
CERT_SIGNING_ENABLED=false
ONCHAIN_ANCHOR_ENABLED=false
# Wallet monitor/firmante DEDICADA (baja de valor, con algo de CELO para gas).
# Debe NO ser el owner del agentId (0x475F...) ni operador aprobado; se
# recomienda distinta tambien de la payTo. Solo en entorno, nunca al repo.
AGENT_SIGNER_KEY=
CERT_SIGNER_ADDRESS=
CELO_CONFIRMATION_TIMEOUT=120
# Persistencia del bloque onchain en Supabase (Edge walcert-certificate-onchain,
# reusa SUPABASE_FUNCTIONS_URL + EDGE_SHARED_SECRET; la service key vive solo
# en la Edge). Poner en false para desactivar.
ONCHAIN_LOG_ENABLED=true
# ONCHAIN_LOG_SLUG=walcert-certificate-onchain
# Public verify facade → Edge walcert-certificate-verify (BD + Celo + EIP-712).
# CERTIFICATE_VERIFY_SLUG=walcert-certificate-verify
# Nota: AGENT_PRIVATE_KEY / OWNER_AGENT_PRIVATE_KEY (owner) queda solo para
# scripts admin (setAgentURI / register); no en runtime del servidor.

# --- Canal interno (adapters de marketplace: ACP, Olas, etc.) ---
# Bearer dedicado; NO reutilizar EDGE_SHARED_SECRET.
# Si el request trae X-Walcert-Marketplace (o Access-Channel: internal) sin
# credenciales válidas → 401. Con Bearer válido → bypass x402 en /v1/certificates/*
# y atribución en walcert.certificate_requests (access_channel/marketplace/billing).
WALCERT_INTERNAL_API_KEY=
WALCERT_INTERNAL_MARKETPLACES=virtuals_acp,olas,circle,x402_bazaar,agentverse

# --- Canal Summit BSG2026 (landing bsg2026; sin x402; key dedicada) ---
# Distinta de WALCERT_INTERNAL_API_KEY. Nunca en el browser (solo server-side
# de la landing → agente). Caducidad hard: desde WALCERT_SUMMIT_EXPIRES_AT → 403.
# Marketplace fijo: bsg2026 (no agregar a WALCERT_INTERNAL_MARKETPLACES).
WALCERT_SUMMIT_API_KEY=
WALCERT_SUMMIT_ENABLED=true
WALCERT_SUMMIT_EXPIRES_AT=2026-08-01T00:00:00+00:00
# Rate limit Summit (ADR 2026-07-28): wallet primary + IP backstop.
# 12 HTTP/wallet = 3 packs (origins+activity+portfolio+multichain-v2).
# WALCERT_SUMMIT_RATE_LIMIT_WALLET=12
# WALCERT_SUMMIT_RATE_LIMIT=500
# WALCERT_SUMMIT_RATE_WINDOW_SECONDS=900

# Cache & HTTP
CACHE_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=30

# Quota (free-tier defaults)
ALCHEMY_CU_PER_TRANSFER_CALL=120
ALCHEMY_MONTHLY_LIMIT_CU=30000000
# Optional daily soft-cap for Alchemy (leave empty to disable)
# ALCHEMY_DAILY_LIMIT_CU=1000000

ZERION_DAILY_LIMIT=2000
# GOLDRUSH_DAILY_LIMIT=500

# --- Walcert Agent ---

# Identity (ERC-8004 on Celo)
AGENT_ID=9699
AGENT_WALLET=0xF4D938200445B0Df0f028af6d90D016147AEd095
PUBLIC_BASE_URL=http://127.0.0.1:8000
CELO_CHAIN_ID=42220

# Data providers (never commit real values)
ALCHEMY_API_KEY=
# Networks for origins/activity (comma-separated Alchemy slugs)
ALCHEMY_NETWORKS=celo-mainnet,bnb-mainnet
# Optional legacy single-network override:
# ALCHEMY_NETWORK=celo-mainnet
# Optional full URL override (disables multi-network list):
# ALCHEMY_HTTP_URL=https://celo-mainnet.g.alchemy.com/v2/YOUR_KEY

MORALIS_API_KEY=
# Comma-separated chain list for CU estimation / query scope
# Celo is not accepted by Moralis wallet/chains on free mainnet list
MORALIS_CHAINS=eth,base,arbitrum,polygon,optimism,bsc

ZERION_API_KEY=

# Supabase Edge scoring (A–F certificates)
SUPABASE_FUNCTIONS_URL=https://mezqyworblseixaypftg.supabase.co/functions/v1
# Same value must be set as Edge secret EDGE_SHARED_SECRET in Supabase
EDGE_SHARED_SECRET=
EDGE_SCORING_ENABLED=true

# --- x402 paywall (Track 2: protocolo estandar via facilitador Celo) ---
# Protege POST /v1/certificates/*. El dashboard usa /v1/preview/* (gratis).
X402_ENABLED=false
# CAIP-2. El facilitador oficial (api.x402.celo.org) hoy solo soporta Celo mainnet.
X402_NETWORK=eip155:42220
X402_FACILITATOR_URL=https://api.x402.celo.org
# API key de x402.celo.org (creditos prepagos para /settle). Opcional para /verify.
X402_FACILITATOR_API_KEY=
X402_FACILITATOR_AUTH_HEADER=X-API-Key
# Wallet que recibe los pagos (payTo). Operativa del agente.
X402_PAY_TO=0xF4D938200445B0Df0f028af6d90D016147AEd095
# Precio por certificado (formato dolar; auto-mapea a USDC 6 dec = 50000 atomic).
X402_PRICE=$0.05

# --- Registro de compras x402 ---
# El agente envia cada pago liquidado a la Edge walcert-payment-log
# (reusa SUPABASE_FUNCTIONS_URL + EDGE_SHARED_SECRET; la service key vive solo
# en la Edge). Poner en false para desactivar el logueo de pagos.
PAYMENT_LOG_ENABLED=true
# PAYMENT_LOG_SLUG=walcert-payment-log

# Cache & HTTP
CACHE_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=30

# Quota (free-tier defaults)
ALCHEMY_CU_PER_TRANSFER_CALL=120
ALCHEMY_MONTHLY_LIMIT_CU=30000000
# Optional daily soft-cap for Alchemy (leave empty to disable)
# ALCHEMY_DAILY_LIMIT_CU=1000000

MORALIS_CU_PER_CHAIN=50
MORALIS_DAILY_LIMIT_CU=40000

ZERION_DAILY_LIMIT=2000
